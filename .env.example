# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Tavily — powers Career → “Belgium marketing leadership” job scan (web search summaries)
TAVILY_API_KEY=tvly-...

# App (template / white-label — set when forking into a new product)
NEXT_PUBLIC_APP_NAME=CMO Ascension Mode
# Short sidebar / monogram wordmark (e.g. ME, HQ, LAB)
NEXT_PUBLIC_APP_MARK=ME
# Browser meta description & social previews
NEXT_PUBLIC_APP_DESCRIPTION=Your personal AI professor and coach. Discipline today. Freedom tomorrow.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin (the user with this email gets the /admin panel)
ADMIN_EMAIL=hardwig@gmail.com
